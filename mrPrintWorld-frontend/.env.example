# --- Lead delivery (EmailJS) -------------------------------------------------
# Copy this file to ".env" and fill in the real values from the EmailJS
# dashboard (https://dashboard.emailjs.com), then restart the dev server.
#
# The SAME three values must also be added in Vercel:
#   Project → Settings → Environment Variables → then REDEPLOY.
# Vite inlines these at build time, so changing them without a redeploy has
# no effect on the live site.
#
# All three are public by design and will appear in the JS bundle. Lock them
# down in EmailJS → Account → Security → "Allowed domains" = mrprintworld.com
# so the sending quota can't be used by anyone else.
#
# Email Services → your Gmail service → Service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# Email Templates → your template → Template ID
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# Account → General → Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx


# --- Analytics (optional) ----------------------------------------------------
# GA4 Measurement ID. Until this is set, no analytics loads at all.
VITE_GA_ID=


# --- Catalogue backend ------------------------------------------------------
# Base URL of the products API. Leave EMPTY to serve the bundled static
# catalogue instead (the pre-migration behaviour).
#   local: http://localhost:4000     prod: https://api.mrprintworld.com
VITE_API_BASE_URL=
